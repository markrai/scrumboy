{
  "name": "scrumboy-web",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.6.1",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/sync-vendor.mjs",
    "sync:vendor": "node scripts/sync-vendor.mjs",
    "verify:vendor": "node scripts/verify-vendor.mjs",
    "verify:i18n": "node scripts/verify-i18n-locales.mjs",
    "generate:landing": "node scripts/generate-landing.mjs",
    "verify:landing": "node scripts/generate-landing.mjs --check",
    "test:landing-layout": "playwright test --config=playwright.config.ts scripts/landing-mobile-mascot.playwright.ts",
    "test:cards-per-lane": "playwright test --config=playwright.config.ts scripts/cards-per-lane.playwright.ts",
    "test:mermaid-browser": "playwright test --config=playwright.config.ts scripts/mermaid-vendor.playwright.ts",
    "test:inline-images": "playwright test --config=playwright.config.ts scripts/inline-images.playwright.ts",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "copy:i18n": "node scripts/copy-i18n-locales.mjs",
    "build:capacitor-web": "node scripts/build-capacitor-web.mjs",
    "verify:capacitor-web": "node scripts/verify-capacitor-web.mjs",
    "build": "node scripts/verify-vendor.mjs && npm run verify:i18n && npm run generate:landing && tsc && npm run copy:i18n",
    "test": "node scripts/verify-vendor.mjs && npm run verify:i18n && npm run verify:landing && node scripts/run-vitest.mjs run",
    "lint:delete-confirms": "node scripts/check-delete-confirms.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "0.25.12",
    "happy-dom": "^20.14.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.0.0",
    "vite": "6.4.4",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "dompurify": "3.4.17",
    "markdown-it": "14.3.3",
    "mermaid": "11.17.2",
    "uplot": "^1.6.32"
  },
  "overrides": {
    "katex": "0.18.2",
    "postcss": {
      ".": "8.5.25",
      "nanoid": "3.3.18"
    },
    "source-map-js": "1.2.2",
    "undici": "7.29.1"
  }
}
